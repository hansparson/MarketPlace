# GostarID Marketplace — Environment Variables Template
# ──────────────────────────────────────────────────────
# Salin file ini:
#   Development : cp .env.example .env.development  (lalu sesuaikan)
#   Production  : cp .env.example .env.production   (lalu isi semua GANTI_*)

APP_ENV=development  # "development" atau "production"

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost          # Docker prod: postgres
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=GANTI_PASSWORD
DB_NAME=app_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost       # Docker prod: redis
REDIS_PORT=6379

# ─── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000   # Docker prod: minio:9000
MINIO_ACCESS_KEY=GANTI_ACCESS_KEY
MINIO_SECRET_KEY=GANTI_SECRET_KEY_MIN_8_CHAR
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=marketplace

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=GANTI_DENGAN_SECRET_PANJANG_MIN_32_KARAKTER

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ─── Cloudflare Tunnel (Production only) ───────────────────────────────────────
# Dapatkan dari: https://one.dash.cloudflare.com → Zero Trust → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=GANTI_DENGAN_TOKEN_TUNNEL_CLOUDFLARE
