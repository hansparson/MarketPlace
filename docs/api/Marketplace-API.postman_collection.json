{
  "info": {
    "name": "Marketplace API",
    "description": "Collection untuk testing Marketplace API Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "marketplace-api-collection",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reseller_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.message_data.token);",
                  "    console.log('Token saved:', jsonData.message_data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@marketplace.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/admin",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "admin"]
            }
          }
        },
        {
          "name": "Reseller Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.message_data.token);",
                  "    console.log('Token saved:', jsonData.message_data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"081234567890\",\n  \"password\": \"reseller123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/reseller",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "reseller"]
            }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "List Products",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "category",
                  "value": "Elektronik",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "province",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Product Detail",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Track Click",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/track/click?product_id={{product_id}}&ref={{reseller_id}}",
              "host": ["{{base_url}}"],
              "path": ["track", "click"],
              "query": [
                {
                  "key": "product_id",
                  "value": "{{product_id}}"
                },
                {
                  "key": "ref",
                  "value": "{{reseller_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Submit Lead",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"ref_code\": \"{{reseller_id}}\",\n  \"phone\": \"081234567890\",\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/leads",
              "host": ["{{base_url}}"],
              "path": ["leads"]
            }
          }
        },
        {
          "name": "Get Provinces",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/provinces",
              "host": ["{{base_url}}"],
              "path": ["provinces"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/dashboard",
              "host": ["{{base_url}}"],
              "path": ["admin", "dashboard"]
            }
          }
        },
        {
          "name": "List All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/products?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["admin", "products"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('product_id', jsonData.message_data.id);",
                  "    console.log('Product ID saved:', jsonData.message_data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"iPhone 15 Pro Max\",\n  \"description\": \"iPhone terbaru dengan kondisi mulus\",\n  \"price\": 20000000,\n  \"category\": \"Elektronik\",\n  \"location_name\": \"Jakarta Selatan\",\n  \"location_province\": \"DKI Jakarta\",\n  \"commission_amount\": 500000,\n  \"contact_phone\": \"081234567890\",\n  \"contact_wa\": \"081234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/products",
              "host": ["{{base_url}}"],
              "path": ["admin", "products"]
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"iPhone 15 Pro Max - Updated\",\n  \"price\": 19500000,\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Upload Product Assets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "product_id",
                  "value": "{{product_id}}",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/products/assets",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "assets"]
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Get Product Leads",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/products/{{product_id}}/leads",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "{{product_id}}", "leads"]
            }
          }
        },
        {
          "name": "Mark Product as Sold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_id\": \"lead-uuid-here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/products/{{product_id}}/sold",
              "host": ["{{base_url}}"],
              "path": ["admin", "products", "{{product_id}}", "sold"]
            }
          }
        },
        {
          "name": "List Resellers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/resellers",
              "host": ["{{base_url}}"],
              "path": ["admin", "resellers"]
            }
          }
        },
        {
          "name": "Create Reseller",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('reseller_id', jsonData.message_data.id);",
                  "    console.log('Reseller ID saved:', jsonData.message_data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reseller@example.com\",\n  \"full_name\": \"John Doe Reseller\",\n  \"phone\": \"081234567890\",\n  \"password\": \"reseller123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/resellers",
              "host": ["{{base_url}}"],
              "path": ["admin", "resellers"]
            }
          }
        },
        {
          "name": "Get Reseller",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/resellers/{{reseller_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "resellers", "{{reseller_id}}"]
            }
          }
        },
        {
          "name": "Update Reseller",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe Updated\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/admin/resellers/{{reseller_id}}",
              "host": ["{{base_url}}"],
              "path": ["admin", "resellers", "{{reseller_id}}"]
            }
          }
        },
        {
          "name": "List Payouts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/payouts",
              "host": ["{{base_url}}"],
              "path": ["admin", "payouts"]
            }
          }
        },
        {
          "name": "Create Payout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "reseller_id",
                  "value": "{{reseller_id}}",
                  "type": "text"
                },
                {
                  "key": "amount",
                  "value": "500000",
                  "type": "text"
                },
                {
                  "key": "notes",
                  "value": "Pembayaran komisi bulan ini",
                  "type": "text"
                },
                {
                  "key": "proof",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/payouts",
              "host": ["{{base_url}}"],
              "path": ["admin", "payouts"]
            }
          }
        }
      ]
    },
    {
      "name": "Client/Reseller",
      "item": [
        {
          "name": "Get Share URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/client/products/{{product_id}}/share",
              "host": ["{{base_url}}"],
              "path": ["client", "products", "{{product_id}}", "share"]
            }
          }
        },
        {
          "name": "Get Product Analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/client/products/{{product_id}}/analytics",
              "host": ["{{base_url}}"],
              "path": ["client", "products", "{{product_id}}", "analytics"]
            }
          }
        },
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/client/stats",
              "host": ["{{base_url}}"],
              "path": ["client", "stats"]
            }
          }
        },
        {
          "name": "Get My Payouts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/client/payouts",
              "host": ["{{base_url}}"],
              "path": ["client", "payouts"]
            }
          }
        }
      ]
    }
  ]
}
