APP_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Jalankan: make infra-up  (docker-compose.dev.yml hanya postgres/redis/minio)
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=marketplace

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-jwt-secret-not-for-production

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=8080
